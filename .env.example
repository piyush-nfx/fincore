# Copy to .env (git-ignored) and fill in your local values.
DB_URL=jdbc:mysql://localhost:3306/fincore?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=change-me

# Base64 of at least 32 random bytes. Generate one in PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
JWT_SECRET=change-me

# Optional admin account created at startup (password: 8-72 characters).
ADMIN_EMAIL=admin@fincore.local
ADMIN_PASSWORD=change-me
